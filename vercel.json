{
  "version": 2,
  "headers": [
    {
      "source": "/(sitemap|sitemap.xml|sitemap-news.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/((?!assets/|robots.txt|sitemap|sitemap.xml|sitemap-news.xml|favicon.ico|api/).*)",
      "destination": "/index.html"
    }
  ]
}
